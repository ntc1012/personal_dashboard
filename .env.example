# Core application
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
JARVIS_OWNER_ID=
JARVIS_ENABLE_DEMO=false

# Background jobs and fixed-channel notifications. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Native Vercel Marketplace integration provides this newer server-only key.
# Either admin key works; SUPABASE_SECRET_KEY takes precedence when both exist.
SUPABASE_SECRET_KEY=
CRON_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RESEND_API_KEY=
NOTIFICATION_EMAIL=
NOTIFICATION_FROM=

# Optional OpenAI-compatible Chat Completions provider.
# Configure token prices and budgets in the app before making a call.
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=
LLM_AUTOMATIONS_ENABLED=false

# Read-only project integrations
GITHUB_TOKEN=
VERCEL_TOKEN=
VERCEL_TEAM_ID=

# Incoming webhooks (server only; never use a deploy hook URL).
GITHUB_WEBHOOK_SECRET=
VERCEL_WEBHOOK_SECRET=

# Optional read-only task/calendar connectors. No credentials are sent to the chatbot.
TODOIST_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
